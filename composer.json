{
    "name": "onetracepro/onetrace-bitrix",
    "description": "1C-Bitrix module for the OneTrace.pro customer data platform: server-side orders, customers and consents, the website tracker, product catalog sync, recommendation widgets and Web Push.",
    "type": "bitrix-d7-module",
    "license": "MIT",
    "keywords": ["onetrace", "bitrix", "1c-bitrix", "cdp", "customer data platform", "ecommerce", "marketing automation", "recommendations", "abandoned cart"],
    "homepage": "https://onetrace.pro",
    "support": {
        "issues": "https://github.com/OneTracePro/onetrace-bitrix/issues",
        "source": "https://github.com/OneTracePro/onetrace-bitrix"
    },
    "require": {
        "php": "^8.2",
        "onetracepro/onetrace-php": "^1.14"
    },
    "require-dev": {
        "justinrainbow/json-schema": "^6.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Onetrace\\Connector\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.29"
        },
        "sort-packages": true
    },
    "extra": {
        "installer-name": "onetrace.connector"
    }
}
